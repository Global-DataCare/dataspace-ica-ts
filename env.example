# Mask ICA endpoints and did document with DID_WEB_DOMAIN (true/false, default: false)
# If true, endpoints and did document will not expose the real domain/IP in alsoKnownAs.
# MASK_LOCAL_ICA=false
# ==============================================================================
# API Runtime
# ==============================================================================
# Recommended deploy env files:
# - .env.deploy.demo
# - .env.deploy.dev
# - .env.deploy.staging
# - .env.deploy.parallel-staging
# - .env.deploy.prod
#
# This repo currently ships:
# - .env.local
# - .env.local.gcloud
# - .env.local.<dataspace>
# - .env.deploy.staging
# - .env.deploy.parallel-staging
# - .env.deploy.<dataspace>
#
# Suggested local/demo baseline:
# NODE_ENV=development
# SECURITY_MODE=demo
# DEMO_ALLOW_INSECURE_BEARER=false

ICA_API_HOST=0.0.0.0
ICA_API_PORT=3310
ICA_LOCAL_TENANT_ID=ica
# Set explicitly per deployment. Avoid relying on Dockerfile defaults.
# NODE_ENV=staging

# ==============================================================================
# Security Mode
# ==============================================================================
# SECURITY_MODE controls transport/auth guardrails:
# - strict: didcomm-plain only for API submit operations (including _search), bearer signature required.
# - compat: keeps legacy _search transports (application/json + x-www-form-urlencoded), bearer signature required.
# - demo: like compat, and bearer signature can be relaxed only with DEMO_ALLOW_INSECURE_BEARER=true.
#         Demo mode also enables bootstrap fallbacks used when the signed PDF still
#         does not expose some claims:
#         - OrganizationCredential `credentialSubject.makesOffer.category`
#           may fallback to the `{sector}` route path value.
#         - OrganizationCredential `credentialSubject.makesOffer.serviceType`
#           may fallback to the demo provider defaults
#           `organization/Composition.cruds,organization/ResearchSubject.cruds`.
#         - representative `credentialSubject.sameAs` may fallback to
#           `legalRepresentativePayload.sameAs` or `.email`.
#         Production intent is stricter:
#         - organization identity/authorization claims must come from the signed PDF
#           or other signed evidence accepted by ICA
#         - frontend/BFF payloads must not be the source of truth for
#           `taxID`, `legalName`, `makesOffer.category`, or `makesOffer.serviceType`
# Default: compat, unless legacy DEMO_MODE=true is set.
# SECURITY_MODE=compat

# Legacy compatibility flag for _search non-DIDComm content-types in compat/demo.
# JSON_LEGACY=true

# Demo-only override: if true and SECURITY_MODE=demo, bearer signature/temporal checks are bypassed.
# Bearer header is still required.
# DEMO_ALLOW_INSECURE_BEARER=false

# Advanced local/demo override for `_verify` payload merge:
# By default, VC claims come only from signed sources (signed PDF annex, signer cert, etc.).
# To allow ICA to merge additional claims from `organizationPayload` /
# `legalRepresentativePayload` even when they are not present in the PDF,
# both flags below must be enabled together:
# DISABLE_STRICT_IDENTITY_SOURCE=true
# ICA_ALLOW_UNVERIFIED_CREDENTIAL_PAYLOADS=true
#
# This is intentionally unsafe for production-style identity issuance.
# Keep it for local/demo/bootstrap scenarios only.
# Example merged claims include organization url/address or representative
# fields passed from an external form when the PDF has not been updated yet.
# In production, `_verify` should be expected to fail if the signed PDF/evidence
# does not contain the fields ICA needs for issuance.
# DISABLE_STRICT_IDENTITY_SOURCE=false
# ICA_ALLOW_UNVERIFIED_CREDENTIAL_PAYLOADS=false

# Optional dataspace label used in OpenAPI title: <DATASPACE_TITLE> ICA Verification API
# DATASPACE_TITLE=GLOBAL-DATACARE

# Namespace used for deterministic VC IDs when DETERMINISTIC_VC_BY_CONTRACT=true.
# It is normalized to lowercase and used as `urn:<namespace>:<sector>:organization|organization-representative:vc:z...`
# DATASPACE_URN_NAMESPACE=<namespace>

# Deterministic VC mode: bind VC ids and evidence document version to the signed PDF contract digest.
# false/empty => keep random UUID ids for backward compatibility
# true => deterministic VC IDs use CIDv1 (raw codec) derived from signed PDF digest,
#         evidence document attachment url fallback is ipfs://<cid>
DETERMINISTIC_VC_BY_CONTRACT=true

# Credential issuance/revocation registry on Hyperledger Fabric.
# NETWORK_MODE remains the default for non-route operations. PDF verification
# uses the canonical path section {networkKind}; legacy "terms" resolves to
# "test". test never writes Fabric, local-network enables identity-local, and
# test-network/network require ICA_CREDENTIAL_LEDGER_ENABLED=true.
NETWORK_MODE=test
ICA_CREDENTIAL_LEDGER_ENABLED=false
ICA_CREDENTIAL_LEDGER_REQUIRED=false
# ICA_CREDENTIAL_LEDGER_CHANNEL=identity-global
# ICA_CREDENTIAL_LEDGER_CHAINCODE=credential-sc
# ICA_FABRIC_MSP_ID=<ICA_MSP_ID>
# HLF_CONNECTION_PEER=<peer-host:port>
# ICA_FABRIC_TLS_SERVER_NAME=<optional-peer-cert-hostname-for-local-port-forward>
# HLF_CONNECTION_PEM=<peer-tls-root-pem-with-escaped-newlines>
# HLF_CERTIFICATE=<fabric-client-certificate-pem-with-escaped-newlines>
# HLF_PRIVATE_KEY=<fabric-client-private-key-pem-with-escaped-newlines>

# CSV of jurisdictions supported by this ICA instance.
ICA_SUPPORTED_JURISDICTIONS=ES

# CSV of sectors supported by this ICA instance.
ICA_SUPPORTED_SECTORS=health-care,animal-care,onehealth-care,onehealth-research,onehealth-insurance

# Governed host onboarding without a signed adhesion PDF. These hosts remain
# bound to the configured route network kinds and must sign the forwarded
# resource with an ES384 key published in their did:web document.
ICA_PREAUTHORIZED_HOST_DOMAINS=globaldatacare.es,member.example
ICA_PREAUTHORIZED_HOST_NETWORK_KINDS=local-network
# Preferred: mounted JSON file containing governance-pinned public did:web
# documents. Use this when an approved host needs its VC before DNS/workload.
# ICA_PREAUTHORIZED_HOST_DID_DOCUMENTS_FILE=/etc/ica/approved-hosts/did-documents.json
# Backwards-compatible inline form for local development only:
# ICA_PREAUTHORIZED_HOST_DID_DOCUMENTS_JSON=[]

# Optional fallback used on some platforms instead of ICA_API_PORT
# PORT=3310

# ==============================================================================
# External Deploy Metadata (cloud_deploy.sh + platform)
# ==============================================================================
# Used by ./cloud_deploy.sh
# FIRESTORE_PROJECT_ID=<dataspace-name>-ica-<version>
# DEPLOY_REGION=europe-southwest1
# DEPLOY_SERVICE_NAME=<dataspace-name>-ica-<version>
# ARTIFACT_REGISTRY_NAME=<dataspace-name>

# Optional deploy script overrides
# LOCAL_IMAGE=dataspace-ica:x.y.z
# IMAGE_TAG=x.y.z
# K8S_NAMESPACE=dataspace-ica
# K8S_CONTEXT=<kubernetes-context>
# GCP_WORKLOAD_IDENTITY_SERVICE_ACCOUNT=dataspace-ica-runtime@<runtime-project>.iam.gserviceaccount.com
# K8S_LOADBALANCER_IP=<IP>

# Platform/service metadata (not directly consumed by ICA runtime)
# LOG_PROVIDER=console
# QUEUE_PROVIDER=mem
# DB_PROVIDER=firestore
# STORAGE_PROVIDER=gcs
# GCS_BUCKET_NAME=<dataspace-name>-ica-<version>
# Local-only credentials file. Do not set in GKE runtime unless file is mounted in pod.
# Create it with:
# gcloud iam service-accounts keys create gcp-service-account.json \
#   --project <runtime-project> \
#   --iam-account=<service-account>@<runtime-project>.iam.gserviceaccount.com
# The JSON project_id must match FIRESTORE_PROJECT_ID.
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# ==============================================================================
# DID / Discovery
# ==============================================================================
# Optional explicit issuer/audience DID for DIDComm envelope
# If not set, will be constructed as did:web:<domain> using DID_WEB_DOMAIN or autodetected from request host/ip.
# ICA_DIDCOMM_ISSUER_DID=did:web:ica.example.com
# ICA_DIDCOMM_AUDIENCE_DID=did:web:ica.example.com

# Optional external domain fallback for did:web derivation
# ICA_EXTERNAL_DOMAIN=ica.example.com
# DID:web domain configuration for canonical organization/member did:web identifiers in issued VCs
# If set, must be either:
#   - Full did:web:<domain> (e.g. did:web:example.org)
#   - Just the domain (e.g. example.org)
# If not set, the domain will be autodetected from the incoming request (host/ip:port).
# DID_WEB_DOMAIN=did:web:example.org
# Optional OpenAPI server URL override (otherwise derived from request host/proto)
# ICA_OPENAPI_SERVER_URL=https://ica.example.com
# Optional explicit sector example override in OpenAPI docs.
# If unset, the first configured supported sector is used.
# ICA_OPENAPI_SECTOR_EXAMPLE=retail

# Optional full DID document JSON override
# ICA_DID_DOCUMENT_JSON={"@context":["https://www.w3.org/ns/did/v1"],"id":"did:web:ica.example.com"}

# Public-only PQC keys used by the ICA communication transport. The runtime
# publishes ML-DSA under authentication, ML-KEM under keyAgreement, and both in
# /.well-known/jwks.json. Never put private JWK members or secret key bytes here.
# ICA_COMMUNICATION_JWKS_JSON={"keys":[{"kid":"ica-comm-sign-2026-01","kty":"AKP","alg":"ML-DSA-44","pub":"..."},{"kid":"ica-comm-enc-2026-01","kty":"OKP","crv":"ML-KEM-768","x":"..."}]}
# Preferred runtime bootstrap: a dedicated secret seed derives independent,
# domain-separated ML-DSA-44 and ML-KEM-768 pairs. When omitted, staging can
# reuse ICA_VC_PRIVATE_KEY_SEED_PASSPHRASE as the root seed while still deriving
# distinct communication keys. The seed/private bytes are never published.
# ICA_COMMUNICATION_KEY_SEED_PASSPHRASE=replace-with-strong-passphrase

# Optional DID service endpoints published in DID document
# ICA_DID_SERVICE_ENDPOINT=https://ica.example.com
# ICA_DCAT_SERVICE_ENDPOINT=/ica/cds-ES/v1/onehealth/dcat3/catalog/request
# ICA_DSP_DATA_SERVICE_ENDPOINT=https://ica.example.com/.well-known/dspace-version
# ICA_DCP_ISSUER_SERVICE_ENDPOINT=https://ica.example.com/presentations/query

# Optional fallback for DCAT path derivation
# ICA_DCAT_JURISDICTION=ES
# ICA_DCAT_SECTOR=onehealth

# ==============================================================================
# Controller Bootstrap (before CA-signed controller credential)
# ==============================================================================
# ICA_SELF_CONTROLLER_KID=ica-controller-es384-001
# ICA_SELF_CONTROLLER_EMAIL=it-director@example.org
# ICA_SELF_CONTROLLER_TENANT_ID=ica
# ICA_SELF_CONTROLLER_MEMBER_TYPE=controller
# ICA_SELF_CONTROLLER_ROLE=RESPRSN
# ICA_SELF_CONTROLLER_JURISDICTION=ES
# ICA_SELF_CONTROLLER_SECTOR=management

# Optional explicit hash / DID override
# ICA_SELF_CONTROLLER_EMAIL_HASH=zQm...
# ICA_SELF_CONTROLLER_DID=did:web:ica.example.com:ica:cds-ES:v1:management:controller:1120:z...

# Optional explicit public key material for controller DID publication
# ICA_SELF_CONTROLLER_PUBLIC_KEY_JWK={"kty":"EC","crv":"P-384","x":"...","y":"..."}
# ICA_SELF_CONTROLLER_X5C=MIIC...,MIID...
# ICA_SELF_CONTROLLER_ALG=ES384

# Security controls (default secure)
DISABLE_CONTROLLER_DIDCOMM_PROOF=false
DISABLE_CONTROLLER_CA_CREDENTIAL_VALIDATION=false
# Optional create-did-document check: require controller.sameAs to match stored Person credentialSubject.sameAs
# ICA_CREATE_DID_REQUIRE_CONTROLLER_SAMEAS_MATCH=false
# Optional v1 demo helper: if organization.publicKeyJwk lacks x5c/x5u, _create attaches deterministic x5c.
# ICA_CREATE_DID_SELF_CA_STAGING=false
# ICA_CREATE_DID_SELF_CA_PASSPHRASE=replace-with-strong-passphrase
# ICA_CREATE_DID_SELF_CA_PASSPHRASE_ENV=ICA_CREATE_DID_SELF_CA_SECRET
# ICA_CREATE_DID_SELF_CA_DOMAIN=ca.staging.example.org
# ICA_CREATE_DID_SELF_CA_NOT_BEFORE=20240101000000Z
# ICA_CREATE_DID_SELF_CA_COUNTRY=ES
# ICA_CREATE_DID_SELF_CA_ROOT_SEED_CONFIG=17:8:1:48
# ICA_CREATE_DID_SELF_CA_ROOT_SEED_SALT=gdc:dataspace:ca:root:seed:v1
# ICA_CREATE_DID_SELF_CA_ISSUER_SEED_CONFIG=17:8:1:48
# ICA_CREATE_DID_SELF_CA_ISSUER_SEED_SALT=gdc:dataspace:ca:issuer:seed:v1

# Optional controller CA policy filters
# ICA_CONTROLLER_CA_TRUST_ANCHOR_PINS_SHA256=ABCD...,EF01...
# ICA_CONTROLLER_CA_ALLOWED_ISSUER_SUBSTRINGS=fnmt,trusted controller ca

# ==============================================================================
# VC Signing Keys
# ==============================================================================
# Option A: direct private key
# ICA_VC_SIGNING_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# ICA_VC_SIGNING_ALG=ES384
# ICA_VC_SIGNING_KEY_ID=
# ICA_VC_SIGNING_PREFERRED_ALG=ES384
# ICA_VC_SIGNING_REQUIRED_FOR_PROD=false
# Offline-issued ICA leaf-to-Root chain. Keep the private key and chain in a
# Kubernetes Secret. x5u, Root DID and certificate pin are public configuration.
# ICA_VC_SIGNING_CERTIFICATE_CHAIN_PEM=-----BEGIN CERTIFICATE-----\n<ica-leaf>\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\n<issuer>\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\n<root>\n-----END CERTIFICATE-----
# Alternative exact x5c JSON array:
# ICA_VC_SIGNING_X5C_JSON=["<leaf-der-base64>","<issuer-der-base64>","<root-der-base64>"]
# Optional override. The ES384 JWK defaults to the canonical public URL below
# even before the certificate chain has been provisioned. PQC keys never inherit it.
# ICA_VC_SIGNING_X5U=https://ica.example.org/.well-known/x509.pem
# ICA_VC_SIGNING_TRUST_REQUIRED=false
# ICA_ROOT_CA_DID=did:web:ca.example.org

# Dedicated subordinate CA for organization/tenant public X.509 certificates.
# This is intentionally separate from ICA_VC_SIGNING_*: the VC-signing leaf is
# CA:FALSE, whereas this certificate must be CA:TRUE (normally pathLen:0).
# ICA_ORGANIZATION_CA_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# ICA_ORGANIZATION_CA_KEY_ID=<RFC-7638-thumbprint>
# ICA_ORGANIZATION_CA_CERTIFICATE_CHAIN_PEM=-----BEGIN CERTIFICATE-----\n<organization-ca>\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\n<issuer>\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\n<root>\n-----END CERTIFICATE-----
# ICA_ORGANIZATION_CA_X5C_JSON=["<organization-ca-der-base64>","<issuer-der-base64>","<root-der-base64>"]
# ICA_ORGANIZATION_CA_X5U=https://ica.example.org/.well-known/organization-ca.pem
# ICA_ROOT_CA_CERT_SHA256=<64-hex-character-root-certificate-fingerprint>
# Optional overrides for offline tests/private mirrors; normal did:web
# resolution derives https://ca.example.org/.well-known/did.json.
# ICA_ROOT_CA_DID_DOCUMENT_URL=https://ca.example.org/.well-known/did.json
# ICA_ROOT_CA_DID_DOCUMENT_JSON={"id":"did:web:ca.example.org",...}

# Option B: deterministic seed-derived key (recommended for bootstrap)
# ICA_VC_PRIVATE_KEY_SEED_PASSPHRASE=replace-with-strong-passphrase
# ICA_VC_PRIVATE_KEY_SEED_PASSPHRASE_FILE=/var/run/secrets/ica/vc-seed-passphrase
# ICA_VC_PRIVATE_KEY_SEED_PASSPHRASE_SECRET_ENV=ICA_VC_PRIVATE_KEY_SEED_PASSPHRASE_SECRET
# ICA_HOST_SECRET_PROVIDER=gcp-secret-manager
# ICA_GCP_PROJECT_ID=your-gcp-project-id
# ICA_VC_PRIVATE_KEY_SEED_PASSPHRASE_GCP_SECRET=ica-vc-private-key-seed-passphrase
# ICA_VC_PRIVATE_KEY_SEED_PASSPHRASE_GCP_SECRET_VERSION=projects/your-gcp-project-id/secrets/ica-vc-private-key-seed-passphrase/versions/latest
# ICA_HOST_SECRET_CACHE_TTL_SECONDS=300
# ICA_HOST_SECRET_STALE_IF_ERROR_SECONDS=21600
# ICA_VC_PRIVATE_KEY_SEED_CONFIG=17:8:1:48
# ICA_VC_PRIVATE_KEY_SEED_SALT=ica-seed-salt-v1
# ICA_VC_SEED_ALG=ES384

# Self-sign behavior
ICA_SELF_SIGN_TEST=true
# ICA_SELF_SIGN_IF_MISSING=true
# ICA_SELF_SIGN_TEST_ALG=ES384
# ICA_SELF_SIGN_TEST_KEY_ID=ica-test-es384
# ICA_SELF_SIGN_TEST_VALID_PROOF=false

# Optional persisted activated-keys file path
# ICA_ACTIVE_SIGNING_KEYS_FILE=./data/active-signing-keys.json

# ==============================================================================
# Verify / Terms Template
# ==============================================================================
ICA_VERIFY_STRICT_REVOCATION=true
ICA_VERIFY_STRICT_TEMPLATE_MATCH=true
ICA_VERIFY_TEMPLATE_MATCH_MODE=logical-content
ICA_VERIFY_DIGEST_ALGORITHM=sha3-384

# Multi-signed PDFs: signatures whose certificate subject contains one of these VAT ids
# are still validated, but ignored when selecting the signer used for credential extraction.
# If configured, _verify requires at least one signer VAT from this list and at least one different signer VAT outside it.
VERIFIERS_VAT_LIST=VATES-B00000000,VATES-G00000000

# Whether to allow and require verification partner signatures in multi-signed PDFs.
ICA_ALLOW_VERIFICATION_PARTNERS=true
# Optional VAT list of verification partners.
# If configured, _verify requires at least one verification partner signature from this list alongside the verifier and counterpart signatures.
VERIFICATION_PARTNERS_VAT_LIST=VATES-A00000000,VATES-C00000000

# Transitional network authorization for ICA member autodiscovery. Empty means
# no remote host is traversed. Use current static IPs until each host has DNS.
# Future registration will replace this entry after validating a governance VC
# issued to the host DID by the data-space Root CA/governance authority.
ICA_MEMBER_DISCOVERY_ALLOWED_HOSTS=192.0.2.10,host.example.org

ICA_ENABLE_TEST_TERMS_PREFIX=false
# Use resourceType=contract to skip template/content validation.
# ICA_TERMS_ACTIVE_RESOURCE_TYPES=202630011200,test-202630011200

ICA_TERMS_TEMPLATE_URL_PATTERN=https://raw.githubusercontent.com/<dataspace-name>/terms/refs/heads/main/dataspace/{sector}/{jurisdictionLower}/{resourceVersion}/terms.pdf
ICA_TERMS_TEMPLATE_CACHE_TTL_SECONDS=900
ICA_TERMS_TEMPLATE_CACHE_MAX_ENTRIES=64

# Optional startup preload
# ICA_TERMS_TEMPLATE_PRELOAD_ENABLED=true
# ICA_TERMS_TEMPLATE_PRELOAD_RESOURCE_TYPES=202630011200,test-202630011200
# ICA_TERMS_TEMPLATE_PRELOAD_SECTORS=animal-care,health-care
# ICA_TERMS_TEMPLATE_PRELOAD_JURISDICTIONS=ES
# ICA_TERMS_TEMPLATE_PRELOAD_TENANT_ID=ica

# ==============================================================================
# CA Trust Material (root and intermediate certificates)
# ==============================================================================
# Trust mode A: inline PEM (highest priority, overrides URL and file modes)
# ICA_FNMT_ROOT_CERT_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# ICA_FNMT_INTERMEDIATE_CERT_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Trust mode B: auto-download from URLs (preferred for production)
# ICA_KNOWN_CERTS_AUTO_DOWNLOAD=true activates URL-based loading.
# ICA_FNMT_AUTO_DOWNLOAD=true is a supported alias for backward compatibility.
ICA_KNOWN_CERTS_AUTO_DOWNLOAD=true

# CSV of root CA certificate URLs (DER or PEM). Add all trusted root CAs here.
# Includes FNMT root by default when ICA_KNOWN_CERTS_AUTO_DOWNLOAD=true and this is unset.
ICA_KNOWN_ROOT_CERT_URLS=https://www.sede.fnmt.gob.es/documents/10445900/10526749/AC_Raiz_FNMT-RCM_SHA256.cer,https://web.uanataca.com/common/project/pdf/autoridad-certificacion/01_raiz-ca-2016.cer,http://www.accv.es/gestcert/accv_root_rsa_eidas_2023.crt,http://www.accv.es/gestcert/accv_root_ecc_eidas_2023.crt

# CSV of intermediate CA certificate URLs (DER or PEM). Add all trusted intermediates here.
ICA_KNOWN_INTERMEDIATE_CERT_URLS=https://www.sede.fnmt.gob.es/documents/10445900/10526749/AC_Representacion.cer,https://www.sede.fnmt.gob.es/documents/10445900/10526749/AC_Sector_Publico.cer,https://www.sede.fnmt.gob.es/documents/10445900/10526749/AC_FNMT_Usuarios.cer,http://www.uanataca.com/public/download/tsp_certificates/subordinate1.crt,http://www.accv.es/gestcert/accv_rsa1_profesionales.crt,http://www.accv.es/gestcert/accv_ecc1_profesionales.crt

# Optional pinning (SHA-256 fingerprints, colon-separated hex)
# ICA_FNMT_ROOT_CERT_PIN_SHA256=
# ICA_FNMT_INTERMEDIATE_CERT_PIN_SHA256=
# ICA_FNMT_INTERMEDIATE_CERT_PINS_SHA256=
# ICA_FNMT_ROOT_CERT_PIN_SHA1=
# ICA_FNMT_INTERMEDIATE_CERT_PIN_SHA1=
# ICA_FNMT_INTERMEDIATE_CERT_PINS_SHA1=

# Trust mode C: file-path fallback (used when ICA_KNOWN_CERTS_AUTO_DOWNLOAD is false)
# ICA_FNMT_ROOT_CERT_PATH=certs/fnmt/fnmt-root.pem
# ICA_FNMT_INTERMEDIATE_CERT_PATH=certs/fnmt/fnmt-intermediate.pem

# ==============================================================================
# Audit Storage
# ==============================================================================
STORAGE_PROVIDER=mem
ICA_AUDIT_STORAGE_REQUIRED=true
ICA_AUDIT_ATTACHMENT_URL_PATTERN=urn:uuid:{objectId}
ICA_AUDIT_STORAGE_GCS_PREFIX=ica-audit
# Required when STORAGE_PROVIDER=ipfs
# IPFS_API_URL=http://127.0.0.1:5001
# IPFS_GATEWAY_URL=http://127.0.0.1:8080
# IPFS_MFS_ROOT=/ica-audit
# Optional confidential-at-rest layer for stored audit PDFs
# ICA_CONFIDENTIAL_STORAGE_ENABLED=false
# ICA_CONFIDENTIAL_STORAGE_KEY_SEED=replace-with-strong-host-seed
# ICA_CONFIDENTIAL_STORAGE_KEY_VERSION=v1
# Required when STORAGE_PROVIDER=gcs
# GCS_BUCKET_NAME=<dataspace-name>-ica-<version>

# ==============================================================================
# Collections Storage (credentials/evidence)
# ==============================================================================
# Suggested prefixes by environment:
# - local gcloud test: test
# - staging: dev
# - parallel staging: parallel-staging
# - production: prod
DB_PROVIDER=mem
ICA_COLLECTIONS_REQUIRED=true
ICA_COLLECTIONS_PREFIX=ica

# Required when DB_PROVIDER=firestore
# FIRESTORE_PROJECT_ID=<dataspace-name>-ica-<version>
# Required when DB_PROVIDER=postgres
# POSTGRES_URL=postgres://user:password@host:5432/database

# One-shot migration CLI (private values; run the synthetic evidence gate first)
# ICA_MIGRATION_CONFIRM_SOURCE_PROJECT=<same-as-FIRESTORE_PROJECT_ID>
# ICA_MIGRATION_SOURCE_COLLECTIONS_PREFIX=dev
# ICA_MIGRATION_TARGET_COLLECTIONS_PREFIX=prod
# ICA_MIGRATION_AUDIT_SOURCE_DIR=/secure/migration/gcs
# ICA_MIGRATION_OUTPUT_DIR=/secure/migration/evidence/run-001
# ICA_MIGRATION_IPFS_CUSTODY=private-encrypted
# ICA_MIGRATION_DATA_PROTECTION_CONFIRMED=true

# ==============================================================================
# Spaces / Dataspace Sync
# ==============================================================================
# Governance anchor DID is shared with the validated signing trust configuration
# above; do not configure a second or unrelated Root authority here.

# JSON target list (recommended)
# Supports @type/resourceType + aliases identifier/url/license
# ICA_SPACES_TARGETS_JSON={"targets":[{"resourceType":"RuntimePlatform","name":"Pontus-X","identifier":"did:web:pontusx.example.org","url":"https://adapter.example.org/dummy-sync","license":"<api-key>"}]}

# CSV fallback
# ICA_SPACES_TARGET_DIDS=did:web:pontusx.example.org,did:web:another-space.example
# ICA_SPACES_DEFAULT_ENDPOINT=https://adapter.example.org/dummy-sync
# ICA_SPACES_DEFAULT_API_KEY=<api-key>

# Sync behavior
# ICA_SPACES_STRICT=false
# ICA_SPACES_TIMEOUT_MS=8000

# ==============================================================================
# vc+jwt Evidence Issuer Trust
# ==============================================================================
# Primary issuer list (JSON/CSV)
# ICA_EVIDENCE_VC_ISSUERS_LIST={"issuers":[{"did":"did:web:pontusx-issuer.example.org"},{"didUrl":"https://issuer.example/.well-known/did.json"}]}

# Optional algorithm allowlist
# ICA_EVIDENCE_VC_ALLOWED_ALGS=ES256K

# Optional metadata cache ttl (seconds)
# ICA_EVIDENCE_VC_ISSUERS_CACHE_TTL_SECONDS=300

# Optional strict x509 chain checks
# ICA_EVIDENCE_VC_ISSUERS_REQUIRE_X509_CHAIN=false
# ICA_EVIDENCE_VC_ISSUERS_TRUST_ANCHOR_PINS_SHA256=ABCD...,EF01...
# ICA_EVIDENCE_VC_ISSUERS_ALLOWED_ISSUER_SUBSTRINGS=fnmt,delta dao

# Optional direct JWK/JWKS overrides
# ICA_EVIDENCE_VCJWT_TRUSTED_JWKS_JSON={"keys":[...]}
# ICA_EVIDENCE_VCJWT_TRUSTED_JWK_JSON={"kty":"EC",...}

# ==============================================================================
# Advanced / Optional Adapter Selection
# ==============================================================================
# ICA_VERIFY_ADAPTER=fnmt
# ICA_VERIFY_ADAPTER_STRICT=false
# ICA_FNMT_ADAPTER_JURISDICTIONS=ES

# ==============================================================================
# Legacy Fallbacks (avoid for new setups)
# ==============================================================================
# ICA_DID_PROTOCOL_SERVICE_ENDPOINT=...             # alias of ICA_DSP_DATA_SERVICE_ENDPOINT
# ICA_DCAT_CATALOG_SERVICE_ENDPOINT=...             # alias of ICA_DCAT_SERVICE_ENDPOINT
# ICA_ALLOW_TEST_RESOURCE_TYPE_PREFIX=false         # legacy fallback for test prefix route validation
# ICA_TERMS_TEMPLATE_USE_TEST_PREFIX=false          # legacy fallback for template behavior
# ICA_VC_ISSUERS_LIST=...                           # alias of ICA_EVIDENCE_VC_ISSUERS_LIST
# ICA_VCISSUERSLIST=...                             # alias of ICA_EVIDENCE_VC_ISSUERS_LIST
# ICA_EVIDENCE_VCJWT_ALLOWED_ISSUERS=...            # legacy/compat
# ICA_PONTUSX_ALLOWED_ISSUERS=...                   # legacy/compat
# ICA_PONTUSX_ALLOWED_ALGS=...                      # alias of ICA_EVIDENCE_VC_ALLOWED_ALGS
# ICA_PONTUSX_TRUSTED_JWKS_JSON=...                 # alias of ICA_EVIDENCE_VCJWT_TRUSTED_JWKS_JSON
# ICA_PONTUSX_TRUSTED_JWK_JSON=...                  # alias of ICA_EVIDENCE_VCJWT_TRUSTED_JWK_JSON
# Only these static IPs, DNS names or HTTP(S) origins may be traversed. Empty
# fails closed. See docs/member-autodiscovery-authorization.md.
# ICA_MEMBER_DISCOVERY_ALLOWED_HOSTS=192.0.2.10,host.example.org
# Maximum age of one authorized host DID/DCAT/Gaia-X discovery snapshot.
ICA_MEMBER_DISCOVERY_MAX_AGE_SECONDS=300
