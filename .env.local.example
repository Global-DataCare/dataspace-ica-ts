# API
# This file is auto-loaded by npm scripts: `api:start` and `api:dev`.
ICA_API_HOST=0.0.0.0
ICA_API_PORT=3310
ICA_LOCAL_TENANT_ID=ica
# Optional DIDComm issuer override (if omitted, uses ICA_DID_DOCUMENT_JSON.id, ICA_EXTERNAL_DOMAIN or Host header/local port)
# ICA_DIDCOMM_ISSUER_DID=did:web:localhost%3A3310
# Optional DIDComm audience override (if omitted, single-tenant defaults to issuer DID)
# ICA_DIDCOMM_AUDIENCE_DID=did:web:ica.example.com
# Optional full DID document JSON served at /.well-known/did.json and /did.json
# ICA_DID_DOCUMENT_JSON={"@context":["https://www.w3.org/ns/did/v1"],"id":"did:web:ica.example.com"}
# Optional DID service endpoint added to generated DID document
# ICA_DID_SERVICE_ENDPOINT=https://ica.example.com
# Bootstrap controller identity (fallback when CA-signed controller credentials are not available yet)
# ICA_SELF_CONTROLLER_KID=ica-controller-kid
# ICA_SELF_CONTROLLER_EMAIL=it.director@example.org
# Controller/member DID derivation (if ICA_SELF_CONTROLLER_DID is not explicitly set)
# ICA_SELF_CONTROLLER_MEMBER_TYPE=controller
# ICA_SELF_CONTROLLER_ROLE=1120
# ICA_SELF_CONTROLLER_JURISDICTION=ES
# ICA_SELF_CONTROLLER_SECTOR=controller
# Optional explicit precomputed member id hash: multibase58(multihash(SHA3-256(id))).
# For controller bootstrap id, use normalized email (trim+lowercase). If omitted, derived from ICA_SELF_CONTROLLER_EMAIL.
# ICA_SELF_CONTROLLER_EMAIL_HASH=zQm...
# Optional explicit controller/member DID override (otherwise derived from issuer DID + route parts above)
# ICA_SELF_CONTROLLER_DID=did:web:ica.example.com:ica:cds-ES:v1:controller:controller:1120:z...
# Optional explicit controller public key JWK/x5c for DID publication
# ICA_SELF_CONTROLLER_PUBLIC_KEY_JWK={"kty":"EC","crv":"P-384","x":"...","y":"..."}
# ICA_SELF_CONTROLLER_X5C=MIIC...,MIID...
# ICA_SELF_CONTROLLER_ALG=ES384
# Controller DIDComm JWS proof is REQUIRED on _activate/_rotate by default.
# Set to true only for controlled testing.
# DISABLE_CONTROLLER_DIDCOMM_PROOF=false
# Controller CA x509 validation is REQUIRED on _activate by default.
# Set to true only for controlled testing.
# DISABLE_CONTROLLER_CA_CREDENTIAL_VALIDATION=false
# Optional trust policies for controller CA chains:
# ICA_CONTROLLER_CA_TRUST_ANCHOR_PINS_SHA256=ABCD...,EF01...
# ICA_CONTROLLER_CA_ALLOWED_ISSUER_SUBSTRINGS=FNMT,Trusted Controller CA
# VC detached JWS signing (production):
# - test-* resourceType always gets intentionally invalid detached JWS proof
# - production resourceType gets valid proof when private key is configured
# ICA_VC_SIGNING_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# ICA_VC_SIGNING_ALG=ES384
# Optional preferred algorithm when multiple activated keys exist (e.g. ES384, ES256K)
# ICA_VC_SIGNING_PREFERRED_ALG=ES384
# Self-sign bootstrap (generated key when enabled or when missing signing key)
# ICA_SELF_SIGN_TEST=true
# ICA_SELF_SIGN_IF_MISSING=true
# ICA_SELF_SIGN_TEST_ALG=ES384
# ICA_SELF_SIGN_TEST_KEY_ID=ica-test-es384
# Deterministic seed-derived signing key (optional, avoids ICA_VC_SIGNING_PRIVATE_KEY_PEM)
# ICA_VC_PRIVATE_KEY_SEED_PASSPHRASE=replace-with-strong-passphrase
# ICA_VC_PRIVATE_KEY_SEED_CONFIG=17:8:1:48
# ICA_VC_PRIVATE_KEY_SEED_SALT=ica-seed-salt-v1
# ICA_VC_SEED_ALG=ES384
# Test resourceType proof behavior:
# - false/default: keeps intentionally invalid detached JWS for test-* routes
# - true: signs test-* routes with the active signing key
# ICA_SELF_SIGN_TEST_VALID_PROOF=true
# If true, production VC generation fails when signing key is missing
# ICA_VC_SIGNING_REQUIRED_FOR_PROD=false

# Verify behavior
ICA_VERIFY_STRICT_REVOCATION=true
ICA_VERIFY_STRICT_TEMPLATE_MATCH=true
# strict-bytes: hash exacto del fichero; logical-content: compara contenido de paginas ignorando estructura de firma.
ICA_VERIFY_TEMPLATE_MATCH_MODE=logical-content
ICA_VERIFY_DIGEST_ALGORITHM=sha3-384
# Audit document persistence (external attachment)
ICA_AUDIT_STORAGE_PROVIDER=none
# If true and storage fails, verification job fails.
ICA_AUDIT_STORAGE_REQUIRED=true
# External attachment URL template placeholders: {provider} {objectId} {objectKey} {bucket}
ICA_AUDIT_ATTACHMENT_URL_PATTERN=urn:uuid:{objectId}
ICA_AUDIT_STORAGE_FS_DIR=data/audit-pdf
ICA_AUDIT_STORAGE_GCS_PREFIX=ica-audit
# Required when ICA_AUDIT_STORAGE_PROVIDER=gcs
# ICA_AUDIT_STORAGE_GCS_BUCKET=your-private-bucket
# Verification collections persistence (issued credentials + evidence records)
# mem for tests/local, firestore for shared cloud persistence
ICA_COLLECTIONS_PROVIDER=mem
# If true and persistence fails, _verify-response fails with 500
ICA_COLLECTIONS_REQUIRED=true
# Firestore naming and options (used when ICA_COLLECTIONS_PROVIDER=firestore)
ICA_COLLECTIONS_FIRESTORE_COLLECTION_PREFIX=ica
ICA_COLLECTIONS_ISSUED_COLLECTION=issued_credentials
ICA_COLLECTIONS_EVIDENCE_COLLECTION=evidence_records
# ICA_COLLECTIONS_FIRESTORE_PROJECT_ID=your-gcp-project
# ICA_COLLECTIONS_FIRESTORE_DATABASE_ID=(default)
# Optional for local testing resourceType like test-202630011200
# Canonical flag: enables both route acceptance and template test-prefix behavior.
ICA_ENABLE_TEST_TERMS_PREFIX=false
# Deprecated fallback (route validation only, used when ICA_ENABLE_TEST_TERMS_PREFIX is unset)
# ICA_ALLOW_TEST_RESOURCE_TYPE_PREFIX=false

# Template source
ICA_TERMS_TEMPLATE_URL_PATTERN=https://raw.githubusercontent.com/Global-DataCare/terms/refs/heads/main/dataspace/{sector}/{jurisdictionLower}/{resourceVersion}/terms.pdf
# Deprecated fallback (template URL behavior only, used when ICA_ENABLE_TEST_TERMS_PREFIX is unset)
# ICA_TERMS_TEMPLATE_USE_TEST_PREFIX=false
# In-memory template cache (0 disables)
ICA_TERMS_TEMPLATE_CACHE_TTL_SECONDS=900
ICA_TERMS_TEMPLATE_CACHE_MAX_ENTRIES=64
# Optional preload on startup (versions CSV)
# ICA_TERMS_TEMPLATE_PRELOAD_ENABLED=true
# ICA_TERMS_TEMPLATE_PRELOAD_RESOURCE_TYPES=202630011200,test-202630011200
# ICA_TERMS_TEMPLATE_PRELOAD_SECTORS=animal-care,health-care
# ICA_TERMS_TEMPLATE_PRELOAD_JURISDICTIONS=ES
# ICA_TERMS_TEMPLATE_PRELOAD_TENANT_ID=ica
# Optional allowlist for active versions (comma-separated). Useful to deprecate old versions.
# ICA_TERMS_ACTIVE_RESOURCE_TYPES=202630011200,test-202630011200

# -------------------------------------------------------------------
# TRUST MODE A (recommended for fixed deployments): inline PEM in env
# -------------------------------------------------------------------
# Use escaped newlines (\n) if your platform does not support multiline values.
# ICA_FNMT_ROOT_CERT_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# ICA_FNMT_INTERMEDIATE_CERT_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Optional pinning (SHA-256 fingerprint, hex with or without colons)
# ICA_FNMT_ROOT_CERT_PIN_SHA256=
# ICA_FNMT_INTERMEDIATE_CERT_PIN_SHA256=
# Optional SHA-1 pinning (compatible with FNMT published fingerprints)
# ICA_FNMT_ROOT_CERT_PIN_SHA1=
# ICA_FNMT_INTERMEDIATE_CERT_PIN_SHA1=

# -------------------------------------------------------------------
# TRUST MODE B (optional): auto-download on startup + pinning
# -------------------------------------------------------------------
# ICA_FNMT_AUTO_DOWNLOAD=true
# ICA_FNMT_ROOT_CERT_URL=https://www.sede.fnmt.gob.es/documents/10445900/10526749/AC_Raiz_FNMT-RCM_SHA256.cer
# ICA_FNMT_INTERMEDIATE_CERT_URLS=https://www.sede.fnmt.gob.es/documents/10445900/10526749/AC_Representacion.cer,https://www.sede.fnmt.gob.es/documents/10445900/10526749/AC_Sector_Publico.cer,https://www.sede.fnmt.gob.es/documents/10445900/10526749/AC_FNMT_Usuarios.cer
# ICA_FNMT_ROOT_CERT_PIN_SHA256=
# ICA_FNMT_INTERMEDIATE_CERT_PINS_SHA256=
# ICA_FNMT_ROOT_CERT_PIN_SHA1=
# ICA_FNMT_INTERMEDIATE_CERT_PINS_SHA1=
# ICA_FNMT_INTERMEDIATE_CERT_URL=https://example.invalid/fnmt-intermediate.pem
# ICA_FNMT_INTERMEDIATE_CERT_PIN_SHA256=
# ICA_FNMT_INTERMEDIATE_CERT_PIN_SHA1=

# -------------------------------------------------------------------
# TRUST MODE C (file-path fallback)
# -------------------------------------------------------------------
# ICA_FNMT_ROOT_CERT_PATH=certs/fnmt/fnmt-root.pem
# ICA_FNMT_INTERMEDIATE_CERT_PATH=certs/fnmt/fnmt-intermediate.pem
