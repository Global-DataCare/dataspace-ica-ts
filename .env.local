# API
ICA_API_HOST=0.0.0.0
ICA_API_PORT=3310
ICA_LOCAL_TENANT_ID=ica

# Controller bootstrap (fallback until CA-signed controller credential is available)
ICA_SELF_CONTROLLER_KID=ica-controller-es384-001
ICA_SELF_CONTROLLER_EMAIL=it-director@example.org
ICA_SELF_CONTROLLER_MEMBER_TYPE=controller
ICA_SELF_CONTROLLER_ROLE=1120
ICA_SELF_CONTROLLER_JURISDICTION=ES
ICA_SELF_CONTROLLER_SECTOR=controller
DISABLE_CONTROLLER_DIDCOMM_PROOF=false
DISABLE_CONTROLLER_CA_CREDENTIAL_VALIDATION=false

# Deterministic seed-derived signing key bootstrap (activate CA-signed key material later)
ICA_VC_PRIVATE_KEY_SEED_PASSPHRASE=replace-with-strong-passphrase
ICA_VC_PRIVATE_KEY_SEED_CONFIG=17:8:1:48
ICA_VC_PRIVATE_KEY_SEED_SALT=ica-seed-salt-v1
ICA_VC_SEED_ALG=ES384
ICA_SELF_SIGN_TEST=true

# Verify behavior
ICA_VERIFY_STRICT_REVOCATION=true
ICA_VERIFY_STRICT_TEMPLATE_MATCH=true
ICA_VERIFY_TEMPLATE_MATCH_MODE=logical-content
ICA_VERIFY_DIGEST_ALGORITHM=sha3-384
ICA_AUDIT_STORAGE_PROVIDER=none
ICA_AUDIT_STORAGE_REQUIRED=false
ICA_AUDIT_ATTACHMENT_URL_PATTERN=urn:uuid:{objectId}
ICA_AUDIT_STORAGE_FS_DIR=data/audit-pdf
ICA_AUDIT_STORAGE_GCS_PREFIX=ica-audit

# Template source
ICA_TERMS_TEMPLATE_URL_PATTERN=https://raw.githubusercontent.com/Global-DataCare/terms/refs/heads/main/dataspace/{sector}/{jurisdictionLower}/{resourceVersion}/terms.pdf
ICA_ENABLE_TEST_TERMS_PREFIX=true

# -------------------------------------------------------------------
# TRUST MODE A (recommended for fixed deployments): inline PEM in env
# -------------------------------------------------------------------
# Use escaped newlines (\n) if your platform does not support multiline values.
# ICA_FNMT_ROOT_CERT_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# ICA_FNMT_INTERMEDIATE_CERT_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Optional pinning (SHA-256 fingerprint, hex with or without colons)
# ICA_FNMT_ROOT_CERT_PIN_SHA256=
# ICA_FNMT_INTERMEDIATE_CERT_PIN_SHA256=

# -------------------------------------------------------------------
# TRUST MODE B (optional): auto-download on startup + pinning
# -------------------------------------------------------------------
ICA_FNMT_AUTO_DOWNLOAD=true
ICA_FNMT_ROOT_CERT_URL=https://www.sede.fnmt.gob.es/documents/10445900/10526749/AC_Raiz_FNMT-RCM_SHA256.cer
ICA_FNMT_INTERMEDIATE_CERT_URLS=https://www.sede.fnmt.gob.es/documents/10445900/10526749/AC_Representacion.cer,https://www.sede.fnmt.gob.es/documents/10445900/10526749/AC_Sector_Publico.cer,https://www.sede.fnmt.gob.es/documents/10445900/10526749/AC_FNMT_Usuarios.cer
# ICA_FNMT_ROOT_CERT_PIN_SHA256=
# ICA_FNMT_INTERMEDIATE_CERT_PINS_SHA256=
# ICA_FNMT_INTERMEDIATE_CERT_URL=https://example.invalid/fnmt-intermediate.pem
# ICA_FNMT_INTERMEDIATE_CERT_PIN_SHA256=

# -------------------------------------------------------------------
# TRUST MODE C (legacy fallback): file paths
# -------------------------------------------------------------------
# ICA_FNMT_ROOT_CERT_PATH=certs/fnmt/fnmt-root.pem
# ICA_FNMT_INTERMEDIATE_CERT_PATH=certs/fnmt/fnmt-intermediate.pem
