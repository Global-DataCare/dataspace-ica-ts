{
  "name": "dataspace-ica",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "Private ICA CLI for onboarding validation, CSR signing and DCAT publication",
  "bin": {
    "ica-cli": "./bin/ica-cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node ./bin/ica-cli.js",
    "check": "node --check ./bin/ica-cli.js && node --check ./src/api/server.ts && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "npm run api:test",
    "dev": "node --env-file-if-exists=.env.deploy.dev ./src/api/server.ts",
    "api:start": "node --env-file-if-exists=.env.deploy.dev ./src/api/server.ts",
    "api:dev": "node --env-file-if-exists=.env.deploy.dev --watch-path=./src ./src/api/server.ts",
    "api:local": "node --env-file-if-exists=.env.local ./src/api/server.ts",
    "api:local:gcloud": "node --env-file-if-exists=.env.local.gcloud ./src/api/server.ts",
    "remote:fullcycle:st-v2": "API_BASE_URL=https://34.36.211.126 CURL_INSECURE=true bash ./scripts/run-org-lifecycle-local.sh",
    "api:start:deploy:demo": "node --env-file-if-exists=.env.deploy.demo ./src/api/server.ts",
    "api:start:deploy:dev": "node --env-file-if-exists=.env.deploy.dev ./src/api/server.ts",
    "api:start:deploy:prod": "node --env-file-if-exists=.env.deploy.prod ./src/api/server.ts",
    "api:export": "node ./src/api/scripts/export-openapi.ts",
    "api:example:activate": "node ./src/api/scripts/print-activate-example.ts",
    "create:terms:pdf": "node ./src/api/scripts/generate-terms-annex-pdf.ts",
    "api:test": "node --test ./test/*.test.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "@google-cloud/storage": "^7.19.0",
    "gdc-common-utils-ts": "^1.1.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.9.3"
  }
}
