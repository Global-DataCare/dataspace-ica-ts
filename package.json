{
  "name": "dataspace-ica",
  "version": "1.2.9",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Private ICA CLI for onboarding validation, CSR signing and DCAT publication",
  "bin": {
    "ica-cli": "./bin/ica-cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node ./bin/ica-cli.js",
    "check": "node --check ./bin/ica-cli.js && node --check ./src/api/server.ts && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "npm run api:test",
    "dev": "node --env-file-if-exists=.env.deploy.dev ./src/api/server.ts",
    "api:start": "node --env-file-if-exists=.env.deploy.dev ./src/api/server.ts",
    "api:dev": "node --env-file-if-exists=.env.deploy.dev --watch-path=./src ./src/api/server.ts",
    "api:local": "node --env-file-if-exists=.env.local ./src/api/server.ts",
    "api:local:fabric": "NETWORK_MODE=local-network ICA_CREDENTIAL_LEDGER_ENABLED=true ICA_CREDENTIAL_LEDGER_REQUIRED=true HLF_CONNECTION_PEER=localhost:7051 ICA_FABRIC_TLS_SERVER_NAME=peer0-org1 node --env-file-if-exists=.env.local --env-file-if-exists=.env.local-fabric ./src/api/server.ts",
    "api:local:gcloud": "node --env-file-if-exists=.env.local.gcloud ./src/api/server.ts",
    "remote:fullcycle": "bash ./scripts/run-org-lifecycle-local.sh",
    "api:start:deploy:demo": "node --env-file-if-exists=.env.deploy.demo ./src/api/server.ts",
    "api:start:deploy:dev": "node --env-file-if-exists=.env.deploy.dev ./src/api/server.ts",
    "api:start:deploy:prod": "node --env-file-if-exists=.env.deploy.prod ./src/api/server.ts",
    "api:export": "node ./src/api/scripts/export-openapi.ts",
    "api:example:activate": "node ./src/api/scripts/print-activate-example.ts",
    "create:terms:pdf": "node ./src/api/scripts/generate-terms-annex-pdf.ts",
    "api:test": "node --test ./test/api*.test.ts",
    "test:host-preauthorization": "node --test ./test/api.host-activation.test.ts ./test/api.preauthorized-host.test.ts",
    "host:activation:create": "node ./bin/ica-cli.js host:activation:create",
    "test:fabric:credential": "node --test ./test/api.credential-ledger.test.ts",
    "test:migration:postgres-ipfs": "node --test ./test/api.postgres-ipfs-migration.test.ts",
    "evidence:migration:postgres-ipfs": "bash ./scripts/run-postgres-ipfs-migration-local.sh",
    "fabric:credential:read": "node ./scripts/read-fabric-credential.mjs",
    "fabric:credential:read:local": "NETWORK_MODE=local-network ICA_CREDENTIAL_LEDGER_ENABLED=true ICA_CREDENTIAL_LEDGER_REQUIRED=true HLF_CONNECTION_PEER=localhost:7051 ICA_FABRIC_TLS_SERVER_NAME=peer0-org1 node --env-file-if-exists=.env.local --env-file-if-exists=.env.local-fabric ./scripts/read-fabric-credential.mjs",
    "fabric:credential:smoke": "node ./scripts/smoke-fabric-credential.mjs",
    "fabric:credential:smoke:local": "NETWORK_MODE=local-network ICA_CREDENTIAL_LEDGER_ENABLED=true ICA_CREDENTIAL_LEDGER_REQUIRED=true HLF_CONNECTION_PEER=localhost:7051 ICA_FABRIC_TLS_SERVER_NAME=peer0-org1 node --env-file-if-exists=.env.local --env-file-if-exists=.env.local-fabric ./scripts/smoke-fabric-credential.mjs",
    "check:skills": "node ./scripts/check-local-skills.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.3.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "@google-cloud/storage": "^7.19.0",
    "@grpc/grpc-js": "^1.14.4",
    "@hyperledger/fabric-gateway": "^1.12.0",
    "gdc-common-utils-ts": "2.7.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "dotenv": "^17.3.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "retry-request": "8.0.2",
    "teeny-request": "10.1.2",
    "http-proxy-agent": "7.0.2",
    "@tootallnate/once": "3.0.1",
    "fast-xml-parser": "5.10.1",
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9",
    "uuid": "11.1.1"
  }
}
