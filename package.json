{
  "name": "dataspace-ica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private ICA CLI for onboarding validation, CSR signing and DCAT publication",
  "bin": {
    "ica-cli": "./bin/ica-cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node ./bin/ica-cli.js",
    "check": "node --check ./bin/ica-cli.js && node --check ./src/api/server.ts && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "npm run api:test",
    "dev": "node --env-file-if-exists=.env.local ./src/api/server.ts",
    "api:start": "node --env-file-if-exists=.env.local ./src/api/server.ts",
    "api:dev": "node --env-file-if-exists=.env.local --watch-path=./src ./src/api/server.ts",
    "api:example:activate": "node ./src/api/scripts/print-activate-example.ts",
    "api:test": "node --test ./test/api.verify.contract.test.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "@google-cloud/storage": "^7.19.0",
    "gdc-common-utils-ts": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.9.3"
  }
}
