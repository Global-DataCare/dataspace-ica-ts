  "proposedNextFieldsForPdfAndVcConsumption": [
    {
      "name": "organization.contactPoint.email",
      "frontendFillable": true,
      "extractedFromPdf": false,
      "status": "proposed",
      "mappedTo": "OrganizationCredential.credentialSubject.contactPoint.email",
      "gwPriorityRule": "Prefer this as controller email over LegalRepresentativeCredential email when both exist"
    },
    {
      "name": "organization.participant.additionalType",
      "frontendFillable": true,
      "extractedFromPdf": false,
      "status": "proposed",
      "mappedTo": "OrganizationCredential.credentialSubject.participant.additionalType",
      "valueFormat": "comma-separated list",
      "allowedTokens": [
        "IndexReader",
        "IndexProvider",
        "DigitalTwinReader",
        "DigitalTwinProvider"
      ],
      "rules": {
        "maxItems": 2,
        "maxIndexFamily": 1,
        "maxDigitalTwinFamily": 1,
        "minItems": 1
      }
    },
    {
      "name": "organization.hostingOrganization.url",
      "frontendFillable": true,
      "extractedFromPdf": false,
      "status": "proposed",
      "mappedTo": "OrganizationCredential.credentialSubject.hostingOrganization.url",
      "notes": "Domain or IP for hosting endpoint used by _activate/_transaction"
    },
    {
      "name": "organization.hostingOrganization.identifier",
      "frontendFillable": true,
      "extractedFromPdf": false,
      "status": "proposed",
      "mappedTo": "OrganizationCredential.credentialSubject.hostingOrganization.identifier",
      "notes": "Hosting provider VAT/tax identifier"
    },
    {
      "name": "organization.makesOffer.category",
      "frontendFillable": false,
      "extractedFromPdf": false,
      "status": "existing-route-driven",
      "mappedTo": "OrganizationCredential.credentialSubject.makesOffer.category",
      "notes": "Authoritative source is route sector in ICA; signed/PDF source is future work"
    }
  ],
  "notes": [
    "The generated annex PDF currently creates only the 8 fillable AcroForm fields under fillableAcroFormFields.",
    "During read/verify, field lookup is case-insensitive.",
    "Visible identity fields can come either from AcroForm names or from text/visible extraction when enabled by verification settings.",
    "This catalog is the dataspace-ica-ts equivalent of the individual-registration field list exported in gdc-common-utils-ts/__tests__/utils-individual-form-pdf.test.ts."
  ]
