          "frontendFillable": true,
          "extractedFromPdf": true,
          "purpose": "Visible organization tax identifier used when signer certificate does not contain organization tax ID or when signer belongs to verifier.",
          "requiredWhen": [
            "signer certificate lacks organization tax ID",
            "the effective signer belongs to VERIFIERS_VAT_LIST and organization identity must come from the document"
          ]
