{
  "document": "dataspace-ica-ts PDF field catalog",
  "scope": "Fields extracted from signed PDFs or intended to be filled before signing",
  "sourceFiles": [
    "src/api/tools/terms-annex-form.ts",
    "src/api/tools/vc-bundle.ts",
    "src/api/request-parsing.ts",
    "src/api/managers/verify-request-manager.ts"
  ],
  "fillableAcroFormFields": [
    {
      "name": "organization.additionalType",
      "label": "Organization profile / additionalType",
      "frontendFillable": true,
      "extractedFromPdf": true,
      "mappedTo": "organization VC credentialSubject.additionalType",
      "example": "sector=onehealth;section=dataprovider;kind=clinic;action=_index-provider,_research-provider"
    },
    {
      "name": "organization.sameAs",
      "label": "Organization sameAs",
      "frontendFillable": true,
      "extractedFromPdf": true,
      "mappedTo": "organization VC credentialSubject.sameAs",
      "example": "did:web:member.example.org"
    },
    {
      "name": "organization.url",
      "label": "Organization primary domain",
      "frontendFillable": true,
      "extractedFromPdf": true,
      "mappedTo": "organization VC credentialSubject.url",
      "example": "member.example.org"
    },
    {
      "name": "organization.alternateName",
      "label": "Organization alias",
      "frontendFillable": true,
      "extractedFromPdf": true,
      "mappedTo": "organization VC credentialSubject.alternateName",
      "example": "acme"
    },
    {
      "name": "organization.registrationNumber",
      "label": "Sector registration number",
      "frontendFillable": true,
      "extractedFromPdf": true,
      "mappedTo": "organization VC credentialSubject.registrationNumber",
      "example": "ES-SAN-REG-0001"
    },
    {
      "name": "person.email",
      "label": "Controller hash/email",
      "frontendFillable": true,
      "extractedFromPdf": true,
      "mappedTo": "person VC credentialSubject.sameAs",
      "notes": "If plain email is provided, backend hashes it before persistence.",
      "example": "zControllerHash"
    },
    {
      "name": "person.alternateName",
      "label": "Controller key id (kid)",
      "frontendFillable": true,
      "extractedFromPdf": true,
      "mappedTo": "person VC credentialSubject.alternateName",
      "example": "controller-es384-20260309"
    },
    {
      "name": "person.additionalType",
      "label": "Controller algorithm",
      "frontendFillable": true,
      "extractedFromPdf": true,
      "mappedTo": "person VC credentialSubject.additionalType",
      "example": "ES384"
    }
  ],
